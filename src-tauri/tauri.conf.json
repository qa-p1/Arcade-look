{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcade Look",
  "version": "0.1.2",
  "identifier": "app.arcadelook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost alook: http://alook.localhost http://127.0.0.1:*",
        "img-src": "'self' alook: http://alook.localhost data: blob: https:",
        "media-src": "'self' alook: http://alook.localhost http://127.0.0.1:* blob: data:",
        "font-src": "'self' alook: http://alook.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' alook: http://alook.localhost 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self' alook: http://alook.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "dmg"
    ],
    "publisher": "Arcade Look contributors",
    "copyright": "Copyright (c) 2026 Arcade Look contributors",
    "homepage": "https://github.com/qa-p1/arcade-look",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Press Space, see anything",
    "longDescription": "Arcade Look is a fast, light, cross-platform Quick Look: preview images, video, audio, PDFs, archives, code, fonts, Markdown, JSON, Office documents, 3D models and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
