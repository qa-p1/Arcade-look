{
  "name": "arcade-look",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "fixtures": "python3 scripts/make-fixtures.py fixtures",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json",
    "test:ui": "node scripts/ui-checks/check.mjs",
    "test:behaviour": "node scripts/ui-checks/behaviour.mjs",
    "test:sanitize": "node scripts/ui-checks/sanitize.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.1",
    "highlight.js": "11.12.0",
    "pdfjs-dist": "6.5.438",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/three": "0.187.0",
    "playwright": "1.65.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "description": "Press Space, see anything.",
  "license": "MIT",
