{
  "schema": 1,
  "app": "arcade.look",
  "version": "0.3.5",
  "groups": [
    {
      "title": "Preview and navigation",
      "context": "app",
      "shortcuts": [
        {
          "id": "close-preview-space",
          "title": "Close the preview",
          "keys": {
            "default": "Space"
          }
        },
        {
          "id": "close-preview-escape",
          "title": "Close the preview or exit fullscreen",
          "keys": {
            "default": "Escape"
          }
        },
        {
          "id": "previous-file",
          "title": "Open the previous file in the folder",
          "keys": {
            "default": "Left"
          }
        },
        {
          "id": "next-file",
          "title": "Open the next file in the folder",
          "keys": {
            "default": "Right"
          }
        },
        {
          "id": "backspace-back",
          "title": "Go back in navigation history",
          "keys": {
            "default": "Backspace"
          }
        },
        {
          "id": "open-default-enter",
          "title": "Open with the default app",
          "keys": {
            "default": "Enter"
          }
        },
        {
          "id": "open-default-ctrl-o",
          "title": "Open with the default app",
          "keys": {
            "default": "Ctrl+O",
            "macos": "Super+O"
          }
        },
        {
          "id": "show-in-folder",
          "title": "Reveal the file in its folder",
          "keys": {
            "default": "Ctrl+R",
            "macos": "Super+R"
          }
        },
        {
          "id": "copy-path",
          "title": "Copy the file path when no text is selected",
          "keys": {
            "default": "Ctrl+C",
            "macos": "Super+C"
          }
        },
        {
          "id": "toggle-info",
          "title": "Show or hide file information",
          "keys": {
            "default": "I"
          }
        },
        {
          "id": "toggle-fullscreen",
          "title": "Toggle fullscreen",
          "keys": {
            "default": "F"
          }
        },
        {
          "id": "quit",
          "title": "Quit Arcade Look",
          "keys": {
            "default": "Ctrl+Q",
            "macos": "Super+Q"
          }
        },
        {
          "id": "help",
          "title": "Open or close the keyboard help",
          "keys": {
            "default": "Shift+Slash"
          }
        }
      ]
    },
    {
      "title": "Back and forward",
      "context": "navigation",
      "shortcuts": [
        {
          "id": "history-back",
          "title": "Go back in navigation history",
          "keys": {
            "default": "Alt+Left"
          }
        },
        {
          "id": "history-forward",
          "title": "Go forward in navigation history",
          "keys": {
            "default": "Alt+Right"
          }
        },
        {
          "id": "mouse-back",
          "title": "Go back with a mouse side button",
          "keys": {
            "default": "MouseBack"
          }
        },
        {
          "id": "mouse-forward",
          "title": "Go forward with a mouse side button",
          "keys": {
            "default": "MouseForward"
          }
        }
      ]
    },
    {
      "title": "Connected actions",
      "context": "connected-actions",
      "shortcuts": [
        {
          "id": "toggle-actions",
          "title": "Open or close available Arcade actions",
          "keys": {
            "default": "A"
          }
        },
        {
          "id": "close-actions",
          "title": "Close the actions menu",
          "keys": {
            "default": "Escape"
          }
        },
        {
          "id": "next-action",
          "title": "Move to the next action",
          "keys": {
            "default": "Down"
          }
        },
        {
          "id": "previous-action",
          "title": "Move to the previous action",
          "keys": {
            "default": "Up"
          }
        }
      ]
    },
    {
      "title": "Image viewer",
      "context": "image",
      "shortcuts": [
        {
          "id": "image-zoom-in",
          "title": "Zoom in",
          "keys": {
            "default": [
              "Equal",
              "Shift+Equal"
            ]
          }
        },
        {
          "id": "image-zoom-out",
          "title": "Zoom out",
          "keys": {
            "default": [
              "Minus",
              "Shift+Minus"
            ]
          }
        },
        {
          "id": "image-fit",
          "title": "Fit the image to the window",
          "keys": {
            "default": "0"
          }
        },
        {
          "id": "image-actual-size",
          "title": "Show the image at actual size",
          "keys": {
            "default": "1"
          }
        },
        {
          "id": "image-rotate",
          "title": "Rotate the image",
          "keys": {
            "default": "R"
          }
        }
      ]
    },
    {
      "title": "PDF viewer",
      "context": "pdf",
      "shortcuts": [
        {
          "id": "pdf-zoom-in",
          "title": "Zoom in",
          "keys": {
            "default": [
              "Equal",
              "Shift+Equal"
            ]
          }
        },
        {
          "id": "pdf-zoom-out",
          "title": "Zoom out",
          "keys": {
            "default": [
              "Minus",
              "Shift+Minus"
            ]
          }
        },
        {
          "id": "pdf-fit",
          "title": "Fit the page to the window",
          "keys": {
            "default": "0"
          }
        },
        {
          "id": "pdf-first-page",
          "title": "Go to the first page",
          "keys": {
            "default": "Home"
          }
        },
        {
          "id": "pdf-last-page",
          "title": "Go to the last page",
          "keys": {
            "default": "End"
          }
        }
      ]
    },
    {
      "title": "PDF page field",
      "context": "pdf-page-field",
      "shortcuts": [
        {
          "id": "pdf-go-to-page",
          "title": "Go to the entered PDF page",
          "keys": {
            "default": "Enter"
          }
        }
      ]
    },
    {
      "title": "Code and text viewer",
      "context": "code",
      "shortcuts": [
        {
          "id": "toggle-wrap",
          "title": "Toggle line wrapping",
          "keys": {
            "default": "W"
          }
        },
        {
          "id": "code-font-increase",
          "title": "Increase text size",
          "keys": {
            "default": [
              "Equal",
              "Shift+Equal"
            ]
          }
        },
        {
          "id": "code-font-decrease",
          "title": "Decrease text size",
          "keys": {
            "default": [
              "Minus",
              "Shift+Minus"
            ]
          }
        },
        {
          "id": "code-font-reset",
          "title": "Reset text size",
          "keys": {
            "default": "0"
          }
        },
        {
          "id": "code-top",
          "title": "Scroll to the start",
          "keys": {
            "default": "Home"
          }
        },
        {
          "id": "code-bottom",
          "title": "Scroll to the end",
          "keys": {
            "default": "End"
          }
        }
      ]
    },
    {
      "title": "Markdown source",
      "context": "markdown-source",
      "shortcuts": [
        {
          "id": "toggle-markdown-source",
          "title": "Switch between rendered Markdown and source",
          "keys": {
            "default": "S"
          }
        },
        {
          "id": "markdown-source-wrap",
          "title": "Toggle line wrapping in Markdown source",
          "keys": {
            "default": "W"
          }
        },
        {
          "id": "markdown-source-font-increase",
          "title": "Increase source text size",
          "keys": {
            "default": [
              "Equal",
              "Shift+Equal"
            ]
          }
        },
        {
          "id": "markdown-source-font-decrease",
          "title": "Decrease source text size",
          "keys": {
            "default": [
              "Minus",
              "Shift+Minus"
            ]
          }
        },
        {
          "id": "markdown-source-font-reset",
          "title": "Reset source text size",
          "keys": {
            "default": "0"
          }
        },
        {
          "id": "markdown-source-top",
          "title": "Scroll source to the start",
          "keys": {
            "default": "Home"
          }
        },
        {
          "id": "markdown-source-bottom",
          "title": "Scroll source to the end",
          "keys": {
            "default": "End"
          }
        }
      ]
    },
    {
      "title": "Video and audio",
      "context": "media",
      "shortcuts": [
        {
          "id": "media-play-pause-k",
          "title": "Play or pause",
          "keys": {
            "default": [
              "K",
              "Shift+K"
            ]
          }
        },
        {
          "id": "media-play-pause-p",
          "title": "Play or pause",
          "keys": {
            "default": [
              "P",
              "Shift+P"
            ]
          }
        },
        {
          "id": "media-back-10",
          "title": "Seek back 10 seconds",
          "keys": {
            "default": [
              "J",
              "Shift+J"
            ]
          }
        },
        {
          "id": "media-forward-10",
          "title": "Seek forward 10 seconds",
          "keys": {
            "default": [
              "L",
              "Shift+L"
            ]
          }
        },
        {
          "id": "media-forward-5",
          "title": "Seek forward 5 seconds",
          "keys": {
            "default": "Up"
          }
        },
        {
          "id": "media-back-5",
          "title": "Seek back 5 seconds",
          "keys": {
            "default": "Down"
          }
        },
        {
          "id": "media-mute",
          "title": "Mute or unmute",
          "keys": {
            "default": [
              "M",
              "Shift+M"
            ]
          }
        },
        {
          "id": "media-speed-down",
          "title": "Reduce playback speed",
          "keys": {
            "default": [
              "Comma",
              "Shift+Comma"
            ]
          }
        },
        {
          "id": "media-speed-up",
          "title": "Increase playback speed",
          "keys": {
            "default": [
              "Period",
              "Shift+Period"
            ]
          }
        }
      ]
    },
    {
      "title": "3D model viewer",
      "context": "model",
      "shortcuts": [
        {
          "id": "model-wireframe",
          "title": "Toggle wireframe view",
          "keys": {
            "default": "W"
          }
        },
        {
          "id": "model-auto-rotate",
          "title": "Toggle model auto-rotation",
          "keys": {
            "default": "A"
          }
        },
        {
          "id": "model-auto-rotate-shift",
          "title": "Toggle model auto-rotation when actions are available",
          "keys": {
            "default": "Shift+A"
          }
        },
        {
          "id": "model-reset",
          "title": "Reset the model view",
          "keys": {
            "default": "0"
          }
        }
      ]
    },
    {
      "title": "Hex viewer",
      "context": "hex",
      "shortcuts": [
        {
          "id": "hex-top",
          "title": "Scroll to the start",
          "keys": {
            "default": "Home"
          }
        },
        {
          "id": "hex-bottom",
          "title": "Scroll to the end",
          "keys": {
            "default": "End"
          }
        }
      ]
    },
    {
      "title": "System shortcut",
      "context": "global",
      "shortcuts": [
        {
          "id": "preview-selection",
          "title": "Preview the current file-manager selection",
          "keys": {
            "default": "Ctrl+Alt+Shift+Space",
            "linux": null,
            "macos": "Ctrl+Alt+Space"
          },
          "rebindable": true
        }
      ]
    }
  ]
}
